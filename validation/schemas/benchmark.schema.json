{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mini-engine.local/schemas/startup-benchmark.schema.json",
  "title": "Mini-Engine startup benchmark",
  "description": "Machine-readable provenance, startup spans, memory, and frame statistics for one rendering sample run.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "capture_status",
    "captured_at",
    "revision",
    "build",
    "system",
    "gpu",
    "asset",
    "settings"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "capture_status": {
      "type": "string",
      "enum": [
        "complete",
        "partial",
        "blocked"
      ]
    },
    "captured_at": {
      "type": "string",
      "format": "date-time"
    },
    "revision": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "git_commit",
        "dirty"
      ],
      "properties": {
        "git_commit": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "dirty": {
          "type": "boolean"
        }
      }
    },
    "build": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "compiler",
        "command"
      ],
      "properties": {
        "type": {
          "type": "string",
          "minLength": 1
        },
        "compiler": {
          "type": "string",
          "minLength": 1
        },
        "command": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "system": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "os",
        "cpu",
        "ram_bytes"
      ],
      "properties": {
        "os": {
          "type": "string",
          "minLength": 1
        },
        "cpu": {
          "type": "string",
          "minLength": 1
        },
        "ram_bytes": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "gpu": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "driver",
        "api"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "driver": {
          "type": "string",
          "minLength": 1
        },
        "api": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "asset": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "profile",
        "entrypoint_sha256",
        "closure_sha256",
        "closure_bytes"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "profile": {
          "type": "string",
          "enum": [
            "ci",
            "dev",
            "full",
            "custom"
          ]
        },
        "entrypoint_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "closure_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "closure_bytes": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "settings": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sample",
        "width",
        "height",
        "camera"
      ],
      "properties": {
        "sample": {
          "type": "string",
          "minLength": 1
        },
        "width": {
          "type": "integer",
          "minimum": 1
        },
        "height": {
          "type": "integer",
          "minimum": 1
        },
        "vsync": {
          "type": "boolean"
        },
        "cold_cache": {
          "type": "boolean"
        },
        "warmup_frames": {
          "type": "integer",
          "minimum": 0
        },
        "measured_frames": {
          "type": "integer",
          "minimum": 1
        },
        "camera": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "name",
            "position",
            "forward",
            "up",
            "vertical_fov_degrees",
            "near_plane",
            "far_plane"
          ],
          "properties": {
            "name": {
              "type": "string",
              "minLength": 1
            },
            "position": {
              "$ref": "#/$defs/vec3"
            },
            "forward": {
              "$ref": "#/$defs/vec3"
            },
            "up": {
              "$ref": "#/$defs/vec3"
            },
            "vertical_fov_degrees": {
              "type": "number",
              "exclusiveMinimum": 0,
              "exclusiveMaximum": 180
            },
            "near_plane": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "far_plane": {
              "type": "number",
              "exclusiveMinimum": 0
            }
          }
        },
        "seed": {
          "type": "integer"
        },
        "fixed_timestep_seconds": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "feature_flags": {
          "type": "object",
          "additionalProperties": {
            "type": [
              "boolean",
              "number",
              "string"
            ]
          }
        }
      }
    },
    "startup": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "total_to_first_frame_ms",
        "spans"
      ],
      "properties": {
        "total_to_first_frame_ms": {
          "type": "number",
          "minimum": 0
        },
        "spans": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "name",
              "duration_ms",
              "thread"
            ],
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1
              },
              "duration_ms": {
                "type": "number",
                "minimum": 0
              },
              "thread": {
                "type": "string",
                "enum": [
                  "main",
                  "worker",
                  "gpu",
                  "mixed"
                ]
              },
              "bytes_read": {
                "type": "integer",
                "minimum": 0
              },
              "items_processed": {
                "type": "integer",
                "minimum": 0
              }
            }
          }
        }
      }
    },
    "memory": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "peak_rss_bytes",
        "retained_cpu_bytes_after_first_frame",
        "retained_cpu_scope"
      ],
      "properties": {
        "peak_rss_bytes": {
          "type": "integer",
          "minimum": 0
        },
        "retained_cpu_bytes_after_first_frame": {
          "type": "integer",
          "minimum": 0
        },
        "retained_cpu_scope": {
          "type": "string",
          "minLength": 1
        },
        "gpu_allocated_bytes_after_first_frame": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "frames": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "raw_cpu_ms",
        "raw_gpu_ms",
        "cpu_median_ms",
        "cpu_p95_ms",
        "gpu_median_ms",
        "gpu_p95_ms"
      ],
      "properties": {
        "raw_cpu_ms": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "number",
            "minimum": 0
          }
        },
        "raw_gpu_ms": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "number",
            "minimum": 0
          }
        },
        "cpu_median_ms": {
          "type": "number",
          "minimum": 0
        },
        "cpu_p95_ms": {
          "type": "number",
          "minimum": 0
        },
        "gpu_median_ms": {
          "type": "number",
          "minimum": 0
        },
        "gpu_p95_ms": {
          "type": "number",
          "minimum": 0
        }
      }
    },
    "readbacks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "source",
          "frame_index",
          "width",
          "height",
          "channels",
          "component_type",
          "byte_order",
          "row_order",
          "data_space",
          "raw_path",
          "sha256",
          "byte_count",
          "finite_count",
          "non_finite_count",
          "channel_statistics"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "source": {
            "type": "string",
            "enum": [
              "default_back_buffer",
              "texture_2d"
            ]
          },
          "frame_index": {
            "type": "integer",
            "minimum": 0
          },
          "width": {
            "type": "integer",
            "minimum": 1
          },
          "height": {
            "type": "integer",
            "minimum": 1
          },
          "channels": {
            "type": "integer",
            "minimum": 1,
            "maximum": 4
          },
          "component_type": {
            "type": "string",
            "enum": [
              "uint8",
              "float32"
            ]
          },
          "byte_order": {
            "const": "little"
          },
          "row_order": {
            "const": "bottom_to_top"
          },
          "data_space": {
            "type": "string",
            "minLength": 1
          },
          "raw_path": {
            "type": "string",
            "minLength": 1
          },
          "sha256": {
            "$ref": "#/$defs/sha256"
          },
          "byte_count": {
            "type": "integer",
            "minimum": 1
          },
          "finite_count": {
            "type": "integer",
            "minimum": 0
          },
          "non_finite_count": {
            "type": "integer",
            "const": 0
          },
          "channel_statistics": {
            "type": "array",
            "minItems": 1,
            "maxItems": 4,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "min",
                "max",
                "mean"
              ],
              "properties": {
                "min": {
                  "type": "number"
                },
                "max": {
                  "type": "number"
                },
                "mean": {
                  "type": "number"
                }
              }
            }
          }
        }
      }
    },
    "validation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "gl_debug_available",
        "gl_debug_message_count",
        "gl_debug_warning_count",
        "gl_debug_error_count",
        "gl_debug_path",
        "gl_debug_byte_count",
        "gl_debug_sha256",
        "non_finite_value_count",
        "exit_code"
      ],
      "properties": {
        "gl_debug_error_count": {
          "type": "integer",
          "const": 0
        },
        "non_finite_value_count": {
          "type": "integer",
          "const": 0
        },
        "exit_code": {
          "const": 0
        },
        "gl_debug_available": {
          "type": "boolean"
        },
        "gl_debug_message_count": {
          "type": "integer",
          "minimum": 0
        },
        "gl_debug_warning_count": {
          "type": "integer",
          "minimum": 0
        },
        "gl_debug_path": {
          "type": "string",
          "minLength": 1
        },
        "gl_debug_byte_count": {
          "type": "integer",
          "minimum": 0
        },
        "gl_debug_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "semantic_checks": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "name",
              "readback",
              "status",
              "required_for_capture",
              "observed_dynamic_range",
              "minimum_dynamic_range"
            ],
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1
              },
              "readback": {
                "type": "string",
                "minLength": 1
              },
              "status": {
                "type": "string",
                "enum": [
                  "pass",
                  "fail"
                ]
              },
              "required_for_capture": {
                "type": "boolean"
              },
              "observed_dynamic_range": {
                "type": "number",
                "minimum": 0
              },
              "minimum_dynamic_range": {
                "type": "number",
                "minimum": 0
              }
            }
          }
        },
        "notes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "observations": {
      "description": "Genuinely observed diagnostics retained by partial/blocked captures. These do not substitute for complete benchmark fields.",
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "value",
          "unit",
          "source"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "value": {
            "type": "number"
          },
          "unit": {
            "type": "string",
            "minLength": 1
          },
          "source": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "blockers": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "capture_status": {
            "const": "complete"
          }
        }
      },
      "then": {
        "required": [
          "startup",
          "memory",
          "frames",
          "readbacks",
          "validation"
        ],
        "properties": {
          "settings": {
            "required": [
              "vsync",
              "cold_cache",
              "warmup_frames",
              "measured_frames",
              "seed",
              "fixed_timestep_seconds"
            ]
          }
        }
      },
      "else": {
        "required": [
          "blockers"
        ]
      }
    }
  ],
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "vec3": {
      "type": "array",
      "prefixItems": [
        {
          "type": "number"
        },
        {
          "type": "number"
        },
        {
          "type": "number"
        }
      ],
      "minItems": 3,
      "maxItems": 3
    }
  }
}
